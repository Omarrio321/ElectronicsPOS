# ========================================
# Electronics POS - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ========================================
# REQUIRED SETTINGS
# ========================================

# Secret key for Flask sessions and CSRF tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Initial admin password (used ONLY when creating first admin user)
ADMIN_PASSWORD=your-secure-admin-password

# ========================================
# DATABASE (MySQL)
# ========================================

# Production database connection string
# Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/electronics_pos

# Test database (optional - used for automated tests)
# TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/electronics_pos_test

# Individual credentials (used by backup_db.bat and restore_db.bat)
# These must match the credentials in DATABASE_URL above
DB_HOST=localhost
DB_NAME=electronics_pos
DB_USER=root
DB_PASSWORD=

# ========================================
# OPTIONAL SETTINGS
# ========================================

# Flask environment (development, production, testing)
FLASK_ENV=development

# ── mDNS / LAN Access ──────────────────────────────────────────────────────────
# Set this to your PC's WiFi/Ethernet IP so that originalelectronics.local
# resolves correctly on all LAN devices (phones, tablets, other PCs).
# Find it with: ipconfig   (look for "IPv4 Address" under WiFi or Ethernet)
# Leave blank to let the server auto-detect (may pick the wrong adapter if you
# have VirtualBox, VMware, or XAMPP virtual adapters installed).
LAN_IP=192.168.x.x

# Session configuration (production recommendations)
# SESSION_TYPE=redis
# REDIS_URL=redis://localhost:6379

# PDF generation (requires wkhtmltopdf installed)
# WKHTMLTOPDF_PATH=C:/Program Files/wkhtmltopdf/bin/wkhtmltopdf.exe
